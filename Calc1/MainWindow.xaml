<Window x:Class="Calc1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="関数電卓" Height="540" Width="340" MinHeight="460" MinWidth="300"
        WindowStartupLocation="CenterScreen" Background="#F2F4F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="4,2,4,2" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExpressionValue" FontSize="15" Foreground="#626A73"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock x:Name="ExpressionOperator" Grid.Column="1" FontSize="15"
                       Foreground="#626A73" Margin="12,0,4,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBox Grid.Row="1" x:Name="Display" Text="0" IsReadOnly="True" TextAlignment="Right"
                 FontSize="32" Margin="2,2,2,12" Padding="8" Background="White"/>
        <UniformGrid Grid.Row="2" Rows="6" Columns="4">
            <Button Content="√x" Click="Function_Click"/>
            <Button Content="1/x" Click="Function_Click"/>
            <Button Content="x²" Click="Function_Click"/>
            <Button Content="n!" Click="Function_Click"/>
            <Button Content="C" Click="Clear_Click"/>
            <Button Content="⌫" Click="Backspace_Click"/>
            <Button Content="±" Click="Sign_Click"/>
            <Button Content="÷" Click="Operator_Click"/>
            <Button Content="7" Click="Digit_Click"/>
            <Button Content="8" Click="Digit_Click"/>
            <Button Content="9" Click="Digit_Click"/>
            <Button Content="×" Click="Operator_Click"/>
            <Button Content="4" Click="Digit_Click"/>
            <Button Content="5" Click="Digit_Click"/>
            <Button Content="6" Click="Digit_Click"/>
            <Button Content="−" Click="Operator_Click"/>
            <Button Content="1" Click="Digit_Click"/>
            <Button Content="2" Click="Digit_Click"/>
            <Button Content="3" Click="Digit_Click"/>
            <Button Content="＋" Click="Operator_Click"/>
            <Button Content="0" Click="Digit_Click"/>
            <Button Content="." Click="Decimal_Click"/>
            <Button Content="00" Click="Digit_Click"/>
            <Button Content="＝" Click="Equals_Click"/>
        </UniformGrid>
    </Grid>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
</Window>
